# Cheela Search — the query surface at search.cheelalabs.com
#
# Copy to `.env.local` and fill in; that filename is gitignored, this one is
# not. Both values are read in `app/api/search/route.ts`, on the server, and
# neither is prefixed `NEXT_PUBLIC_` — see below for why that matters.
#
#   cp .env.example .env.local
#
# Vercel holds the deployed copies: SEARCH_API_URL as a plain environment
# variable, SEARCH_API_TOKEN as an encrypted one.

# ─────────────────────────────────────────────────────────────────────────────
# THE QUERY PLANE
# ─────────────────────────────────────────────────────────────────────────────

# Where `apps/search-api` is answering. No trailing slash — the route appends
# `/search` to it.
#
# **Unset is not "broken", it is a different mode.** With no value here the
# route answers from the fixture corpus in `lib/search/pipeline.ts`, so the
# surface runs in a checkout with no backend. In development that is the point.
# In production it is a search engine returning invented results, so the route
# refuses to start that way rather than serving fiction convincingly.
# NOT https://api.cheelalabs.com — that is `apps/server`, the platform API, and
# it is a genuinely easy mistake: it serves a healthy /health, a valid
# certificate and a 200 on the front page. It simply has no /search route, so
# every query comes back 404 and the surface reports a search outage that is
# really one wrong hostname. The right host answers /health with
# {"service":"search-api"}.
SEARCH_API_URL=https://search-api.cheelalabs.com

# The API's bearer secret. Not authentication — it is what stops a public URL
# from being a public search engine, since every query it serves spends money on
# external retrieval.
#
# Server-side only, and the leading `NEXT_PUBLIC_` it does not have is the whole
# reason `/api/search` proxies rather than letting the browser call the API
# directly: a token the browser holds is a token anybody holds.
#
# Must match SEARCH_API_TOKEN on the API. Mismatched, every search fails with a
# 401 the route names explicitly.
SEARCH_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# SESSIONS
# ─────────────────────────────────────────────────────────────────────────────

# Where the dashboard is, which is where this surface fetches the JWKS to verify
# the SuperTokens session cookie a visitor already holds. Only used to draw the
# account chip; searching requires no session at all.
#
# The default in `lib/auth/session.ts` is the production dashboard, so this is
# only worth setting when pointing a local surface at a local dashboard.
# NEXT_PUBLIC_DASHBOARD_ORIGIN=http://localhost:3001
